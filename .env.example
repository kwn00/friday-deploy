# 서버 포트
PORT=8787
# 세션 토큰 / 결과 서명용 HMAC 시크릿. 프로덕션에서는 반드시 32바이트 이상 랜덤 값으로 설정 (미설정 시 프로덕션 기동 거부)
SESSION_SECRET=
# 추가로 허용할 Origin (쉼표 구분). 기본은 same-origin 만 허용
ALLOWED_ORIGINS=

# ── 클라이언트 IP (IP 당 연결 수 · 세션 발급 레이트리밋에 사용) ──
# 둘 다 비우면 소켓 주소를 쓴다 (프록시 없이 직접 서비스할 때).
# 엣지/CDN 이 덮어쓰는 단일 값 헤더 이름 (쉼표로 여러 개, 앞에서부터 우선). 예: Render/Cloudflare 는 cf-connecting-ip
# 그 헤더를 클라이언트가 직접 보낼 수 없는 환경에서만 설정할 것.
CLIENT_IP_HEADER=
# X-Forwarded-For 를 붙이는 신뢰 프록시 홉 수. 1 이면 맨 오른쪽 값을 쓴다 (맨 앞 값은 위조 가능하므로 쓰지 않는다)
TRUST_PROXY=0

# ── 클라이언트(빌드 시) ──
# 클라이언트를 Vercel 등 별도 도메인에 배포할 때 게임 서버 주소. 비우면 same-origin.
# 이 경우 서버 쪽 ALLOWED_ORIGINS 에 클라이언트 도메인(예: https://friday-deploy.vercel.app)을 반드시 추가.
VITE_GAME_SERVER_URL=
